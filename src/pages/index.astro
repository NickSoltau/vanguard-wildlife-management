---
import BrandMark from '../components/BrandMark.astro';
import FaqSchema from '../components/FaqSchema.astro';

const PHONE_DISPLAY = '760-315-1733';
const PHONE_TEL = '+17603151733';
const EMAIL = 'info@vanguardwildlifemgmt.com';

const services = [
  {
    icon: '/images/icon-nuisance-wildlife.png',
    iconSize: [79, 78],
    title: 'Trapping & Removal',
    body: 'Trapping and hunting-style removal of deer, geese, woodchucks, possums, raccoons, coyotes, rats, mice, and pigeons that damage crops, barns, and feed storage. No poisons, ever.',
  },
  {
    icon: '/images/icon-hazing.png',
    iconSize: [80, 80],
    title: 'Hazing & Deterrents',
    body: 'Non-lethal options that move problem wildlife off your property, from scare devices to active hazing, so you can often solve the problem without removal.',
  },
  {
    icon: '/images/icon-permit.png',
    iconSize: [80, 80],
    title: 'Nuisance Permit Assistance',
    body: 'We help you apply for and work through Ohio nuisance permits for deer and geese, from documenting the damage to understanding the timing.',
  },
  {
    icon: '/images/icon-property.png',
    iconSize: [80, 80],
    title: 'Assessment & Monitoring',
    body: 'We walk your property, find where and how the damage is happening, and give you a plan. Ongoing monitoring is available for recurring problems.',
  },
];

const audiences = [
  'Farms & Ranches',
  'Feed Mills',
  'Cemeteries',
  'Golf Courses',
  'Municipalities',
];

const steps = [
  {
    title: 'Assessment & Permit Help',
    body: 'We walk your property, document the damage, and help you complete the permit application. The state issues the permit and sets how many animals are allowed, based on the damage.',
  },
  {
    title: 'Removal & Deterrents',
    body: 'Our team handles the work. Anyone who shoots on your property is named on the permit and background-checked, as our license requires. You can be as involved as you like.',
  },
  {
    title: 'Cleanup & Donation',
    body: 'Carcass removal is available as an option. Venison is donated to organizations that will accept it. We never sell any part of an animal.',
  },
];

const faqs = [
  {
    question: 'What animals do you deal with?',
    answer:
      'Deer, geese, woodchucks, possums, raccoons, coyotes, rats, mice, and pigeons, with a focus on species causing damage to crops, barns, and feed storage on rural and agricultural properties.',
  },
  {
    question: 'Do you handle nuisance permits for deer and geese?',
    answer:
      'We help you through the process. We walk your property, document the damage, and help you complete the application and understand the timing. The state issues the permit and decides how many animals are allowed, based on the damage.',
  },
  {
    question: 'What methods do you use?',
    answer:
      'We offer both non-lethal and lethal options. Non-lethal means hazing and deterrents. When removal is needed, we use trapping and hunting-style methods. We never use poisons, pesticides, or rodenticides.',
  },
  {
    question: 'Who does the work on my property?',
    answer:
      'Our team does. Anyone who shoots on your property is named on the permit and has passed a background check, as our license requires. You can be as involved as you want, from hands-off to working alongside us.',
  },
  {
    question: 'How does pricing work?',
    answer:
      'Every property is different, so we give a custom quote. It is built from three parts: the assessment and permit help, removal priced per animal, and optional carcass removal. The state permit sets how many animals are allowed, so the scope is clear up front.',
  },
  {
    question: 'What happens to the deer afterward?',
    answer:
      'Carcass removal is an option if you want it. We donate venison to organizations that will accept it. We never sell any part of an animal.',
  },
  {
    question: 'How fast can you respond?',
    answer: 'We respond to inquiries within 24 hours.',
  },
  {
    question: 'What areas do you serve?',
    answer: 'Northwest Ohio and surrounding areas, focused on agricultural and rural properties.',
  },
  {
    question: 'Are your methods humane?',
    answer: 'Yes. All our methods follow AVMA (American Veterinary Medical Association) humane handling standards.',
  },
  {
    question: 'Do you use pesticides or chemicals?',
    answer:
      'No. We do not use poisons, pesticides, or rodenticides. The safety of children, pets, and livestock on your property is a top priority in every method we use.',
  },
];

const title = 'Vanguard Wildlife Management | Nuisance Wildlife Control, Northwest Ohio';
const description =
  'Chemical-free nuisance wildlife control for farms and rural properties in Northwest Ohio: trapping, hazing and deterrents, permit assistance, and property assessments. Ohio-certified. AVMA humane methods.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL('/images/hero-bg.jpg', Astro.site)} />
    <meta property="og:site_name" content="Vanguard Wildlife Management" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/images/hero-bg.jpg', Astro.site)} />

    <link rel="preload" as="image" href="/images/hero-bg.jpg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sancreek&family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ProfessionalService',
      name: 'Vanguard Wildlife Management',
      description,
      url: String(Astro.site),
      telephone: PHONE_TEL,
      email: EMAIL,
      image: new URL('/images/logo-full.png', Astro.site),
      areaServed: {
        '@type': 'State',
        name: 'Ohio',
      },
      address: {
        '@type': 'PostalAddress',
        addressRegion: 'OH',
        addressCountry: 'US',
      },
      founder: [
        { '@type': 'Person', name: 'Nick Soltau' },
        { '@type': 'Person', name: 'Jeff Yerington' },
      ],
      slogan: 'Protecting Your Property | Balancing Wildlife | Preserving Tomorrow',
    })} />

    <FaqSchema items={faqs} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href="/" class="brand" aria-label="Vanguard Wildlife Management, home">
          <BrandMark eager />
        </a>
        <nav class="header-actions" aria-label="Quick contact">
          <a class="btn btn-ghost" href={`tel:${PHONE_TEL}`}>{PHONE_DISPLAY}</a>
          <a class="btn btn-solid" href={`mailto:${EMAIL}`}>Email Us</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="hero-photo" role="img" aria-label="Vanguard Wildlife Management logo with a whitetail buck and a wolf on either side of a mountain peak"></div>
        <div class="hero-content">
          <div class="wrap">
            <p class="tagline">Protecting Your Property <span aria-hidden="true">|</span> Balancing Wildlife <span aria-hidden="true">|</span> Preserving Tomorrow</p>
            <p class="subline">100% Chemical-Free &amp; Pesticide-Free — Safe for Kids, Pets, and Livestock</p>
            <div class="hero-ctas">
              <a class="btn btn-solid btn-lg" href={`tel:${PHONE_TEL}`}>Call Now: {PHONE_DISPLAY}</a>
              <a class="btn btn-outline btn-lg" href={`mailto:${EMAIL}`}>Email Us</a>
            </div>
          </div>
        </div>
      </section>

      <section class="services" id="services" aria-labelledby="services-heading">
        <div class="wrap">
          <h2 id="services-heading">What We Handle</h2>
          <div class="service-grid">
            {services.map((service) => (
              <article class="service-card">
                <img
                  src={service.icon}
                  width={service.iconSize[0]}
                  height={service.iconSize[1]}
                  alt=""
                  class="service-icon"
                  loading="lazy"
                />
                <h3>{service.title}</h3>
                <p>{service.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="serve" id="serve" aria-labelledby="serve-heading">
        <div class="wrap">
          <h2 id="serve-heading">Who We Serve</h2>
          <ul class="serve-list">
            {audiences.map((name) => <li>{name}</li>)}
          </ul>
          <p class="serve-note">And other rural landowners and agricultural businesses across Northwest Ohio.</p>
        </div>
      </section>

      <section class="how" id="how-it-works" aria-labelledby="how-heading">
        <div class="wrap">
          <h2 id="how-heading">How It Works</h2>
          <ol class="steps">
            {steps.map((step) => (
              <li class="step">
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="about" id="about" aria-labelledby="about-heading">
        <div class="wrap about-inner">
          <h2 id="about-heading">Built on the Ground, Not in a Boardroom</h2>
          <p>
            Vanguard Wildlife Management was founded by Nick Soltau and Jeff Yerington — lifelong hunters
            with experience ranging from small game to trophy big game across the region. That firsthand
            knowledge of how wildlife moves, feeds, and behaves is what sets our approach apart from a
            typical pest control outfit.
          </p>
          <p>
            We hold the Ohio Commercial Nuisance Wild Animal Control Certification and specialize in
            agricultural and rural properties, where unmanaged deer, geese, and other wildlife can mean
            real losses at harvest. We start with non-lethal hazing and deterrents where they work, and
            use trapping or hunting-style removal when they don't. All of our methods follow AVMA humane
            handling standards, and we never use poisons, pesticides, or rodenticides. The safety of your
            kids, pets, and livestock comes first, always.
          </p>
          <p>
            Our goal isn't just removal — it's a lasting, balanced solution that protects your land without
            losing sight of responsible wildlife management.
          </p>
          <p class="service-area">Proudly serving Northwest Ohio and the surrounding area.</p>
        </div>
      </section>

      <section class="faq" id="faq" aria-labelledby="faq-heading">
        <div class="wrap">
          <h2 id="faq-heading">Frequently Asked Questions</h2>
          <div class="faq-list">
            {faqs.map((item) => (
              <details class="faq-item">
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <div
        class="landscape-banner"
        role="img"
        aria-label="Whitetail buck standing in an Ohio field at sunset"
      ></div>
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <BrandMark stacked />
        <div class="footer-contact">
          <a href={`tel:${PHONE_TEL}`}>{PHONE_DISPLAY}</a>
          <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
          <span>Northwest Ohio &amp; Surrounding Areas</span>
        </div>
        <p class="footer-tagline">People <span aria-hidden="true">|</span> Property <span aria-hidden="true">|</span> Wildlife <span aria-hidden="true">|</span> A Balanced Tomorrow</p>
        <p class="footer-copy">&copy; {new Date().getFullYear()} Vanguard Wildlife Management LLC. All rights reserved.</p>
      </div>
    </footer>

    <style>
      :root {
        --near-black: #101210;
        --near-black-deep: #0a0a09;
        --cream: #ede5d9;
        --tan-light: #e8dcc3;
        --tan: #d9c8ac;
        --olive: #5f5d3c;
        --olive-light: #99936b;
        --ink: #1c1a15;
        --max-width: 1120px;
        --font-display: 'Sancreek', serif;
        --font-heading: 'Oswald', sans-serif;
        --font-body: 'Inter', sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--cream);
        color: var(--ink);
        font-family: var(--font-body);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      h1,
      h2,
      h3 {
        font-family: var(--font-heading);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--ink);
        margin: 0 0 0.6em;
      }

      p {
        margin: 0 0 1em;
      }

      a {
        color: inherit;
      }

      img {
        max-width: 100%;
      }

      .wrap {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 24px;
      }

      /* header */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 20;
        background: var(--near-black);
        border-bottom: 3px solid var(--olive-light);
      }

      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
      }

      .brand {
        display: inline-flex;
        text-decoration: none;
      }

      .header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-heading);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 10px 18px;
        border-radius: 2px;
        text-decoration: none;
        border: 2px solid transparent;
        transition: transform 0.15s ease, background-color 0.15s ease, color 0.15s ease;
        white-space: nowrap;
      }

      .btn:hover {
        transform: translateY(-1px);
      }

      .btn-solid {
        background: var(--tan);
        color: var(--near-black-deep);
        border-color: var(--tan);
      }

      .btn-solid:hover {
        background: var(--tan-light);
      }

      .btn-ghost {
        background: transparent;
        color: var(--cream);
        border-color: var(--olive-light);
      }

      .btn-ghost:hover {
        background: rgba(153, 147, 107, 0.18);
      }

      .btn-outline {
        background: transparent;
        color: var(--ink);
        border-color: var(--ink);
      }

      .btn-outline:hover {
        background: var(--ink);
        color: var(--cream);
      }

      .btn-lg {
        font-size: 1rem;
        padding: 16px 30px;
      }

      /* hero */
      .hero {
        background: var(--near-black-deep);
      }

      .hero-photo {
        width: 100%;
        height: min(58vw, 480px);
        min-height: 260px;
        background: url('/images/hero-bg.jpg') center top / cover no-repeat, var(--near-black-deep);
        position: relative;
      }

      .hero-photo::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, rgba(10, 10, 9, 0) 62%, rgba(10, 10, 9, 1) 100%);
      }

      .hero-content {
        background: var(--near-black-deep);
        color: var(--cream);
        text-align: center;
        padding: 8px 0 56px;
      }

      .tagline {
        font-family: var(--font-heading);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-weight: 600;
        font-size: clamp(0.95rem, 2vw, 1.25rem);
        color: var(--tan);
        max-width: 720px;
        margin: 0 auto 10px;
      }

      .subline {
        max-width: 560px;
        margin: 0 auto 1em;
        color: var(--cream);
        opacity: 0.9;
        font-size: 1.05rem;
      }

      .hero-ctas {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        justify-content: center;
        margin-top: 12px;
      }

      .hero-ctas .btn-outline {
        color: var(--cream);
        border-color: var(--cream);
      }

      .hero-ctas .btn-outline:hover {
        background: var(--cream);
        color: var(--near-black-deep);
      }

      /* services */
      .services {
        padding: 72px 0;
      }

      .services h2,
      .about h2,
      .faq h2 {
        text-align: center;
        font-size: clamp(1.5rem, 3vw, 2.1rem);
        margin-bottom: 40px;
      }

      .service-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 24px;
      }

      .service-card {
        background: var(--near-black);
        color: var(--cream);
        padding: 32px 24px;
        border-top: 4px solid var(--olive-light);
        text-align: center;
      }

      .service-icon {
        width: 64px;
        height: auto;
        margin-bottom: 16px;
      }

      .service-card h3 {
        color: var(--cream);
        font-size: 1.05rem;
        margin-bottom: 12px;
      }

      .service-card p {
        color: var(--tan-light);
        font-size: 0.92rem;
        margin: 0;
      }

      /* who we serve */
      .serve {
        background: var(--near-black);
        color: var(--cream);
        padding: 64px 0;
        text-align: center;
      }

      .serve h2 {
        color: var(--cream);
        text-align: center;
        font-size: clamp(1.5rem, 3vw, 2.1rem);
        margin-bottom: 32px;
      }

      .serve-list {
        list-style: none;
        margin: 0 0 20px;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
      }

      .serve-list li {
        font-family: var(--font-heading);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-weight: 600;
        padding: 12px 22px;
        border: 2px solid var(--olive-light);
        color: var(--tan);
      }

      .serve-note {
        color: var(--tan-light);
        margin: 0;
      }

      /* how it works */
      .how {
        padding: 72px 0;
      }

      .how h2 {
        text-align: center;
        font-size: clamp(1.5rem, 3vw, 2.1rem);
        margin-bottom: 40px;
      }

      .steps {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 24px;
        counter-reset: step;
      }

      .step {
        counter-increment: step;
        background: #fff;
        border: 1px solid rgba(28, 26, 21, 0.15);
        border-top: 4px solid var(--olive-light);
        padding: 28px 24px;
      }

      .step::before {
        content: counter(step);
        display: block;
        font-family: var(--font-display);
        font-size: 2rem;
        color: var(--olive);
        margin-bottom: 8px;
      }

      .step h3 {
        font-size: 1.05rem;
        margin-bottom: 10px;
      }

      .step p {
        margin: 0;
        color: #4a4638;
        font-size: 0.95rem;
      }

      /* about */
      .about {
        background: var(--tan-light);
        padding: 72px 0;
      }

      .about-inner {
        max-width: 760px;
      }

      .about p {
        font-size: 1.05rem;
      }

      .service-area {
        font-family: var(--font-heading);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-weight: 600;
        color: var(--olive);
      }

      /* faq */
      .faq {
        padding: 72px 0 88px;
      }

      .faq-list {
        max-width: 760px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .faq-item {
        background: #fff;
        border: 1px solid rgba(28, 26, 21, 0.15);
        border-radius: 4px;
        padding: 4px 20px;
      }

      .faq-item summary {
        cursor: pointer;
        font-family: var(--font-heading);
        font-weight: 600;
        letter-spacing: 0.01em;
        padding: 16px 0;
        list-style: none;
      }

      .faq-item summary::-webkit-details-marker {
        display: none;
      }

      .faq-item summary::after {
        content: '+';
        float: right;
        font-size: 1.3rem;
        color: var(--olive-light);
      }

      .faq-item[open] summary::after {
        content: '\2212';
      }

      .faq-item p {
        padding-bottom: 18px;
        color: #4a4638;
      }

      /* landscape banner */
      .landscape-banner {
        width: 100%;
        aspect-ratio: 791 / 173;
        background: url('/images/landscape-deer.jpg') center / cover no-repeat, var(--near-black-deep);
      }

      /* footer */
      .site-footer {
        background: var(--near-black-deep);
        color: var(--tan-light);
        padding: 48px 0 32px;
        text-align: center;
      }

      .footer-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 18px;
      }

      .footer-contact {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 24px;
        justify-content: center;
        font-size: 0.95rem;
      }

      .footer-contact a {
        text-decoration: none;
        color: var(--cream);
      }

      .footer-contact a:hover {
        color: var(--tan);
      }

      .footer-tagline {
        font-family: var(--font-heading);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-size: 0.85rem;
        color: var(--olive-light);
        margin: 0;
      }

      .footer-copy {
        font-size: 0.75rem;
        opacity: 0.6;
        margin: 0;
      }

      @media (max-width: 640px) {
        .header-inner {
          flex-direction: column;
          gap: 10px;
        }
      }
    </style>
  </body>
</html>
