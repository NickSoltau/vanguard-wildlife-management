---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg
  class={`vwm-wordmark ${className}`}
  viewBox="0 0 360 64"
  role="img"
  aria-label="Vanguard Wildlife Management"
  xmlns="http://www.w3.org/2000/svg"
>
  <g fill="none" stroke="#f2ead9" stroke-width="3" stroke-linejoin="round">
    <polygon points="28,50 44,16 60,50" fill="#b7a878" opacity="0.85" />
    <polygon points="16,50 30,24 44,50" fill="#b7a878" opacity="0.6" />
    <polygon points="40,26 44,16 48,26 44,32" fill="#f2ead9" opacity="0.9" />
  </g>
  <text x="76" y="32" font-family="'Sancreek', serif" font-size="30" fill="#f2ead9" letter-spacing="1">VWM</text>
  <text x="76" y="52" font-family="'Oswald', sans-serif" font-weight="600" font-size="13" fill="#b7a878" letter-spacing="2.5">VANGUARD WILDLIFE MGMT</text>
</svg>
